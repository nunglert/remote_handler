# Print the task and run range
echo This is task $SLURM_ARRAY_TASK_ID

# Map each global run index to its calcdir index. Default map_indices is
# 0..N-1 (so run i -> calcdir/i), but a subset rerun (e.g. map_indices=[0,2,5])
# targets exactly those calcdirs -- mirroring the direct executor.
MAP=({{ map_indices | join(' ') }})

PER_TASK={{per_task}}

# Calculate the starting and ending values for this task
START_NUM=$(( ($SLURM_ARRAY_TASK_ID - 1) * $PER_TASK + 1 ))
END_NUM=$(( $SLURM_ARRAY_TASK_ID * $PER_TASK ))

# Print the task and run range
echo This is task $SLURM_ARRAY_TASK_ID, which will do runs $START_NUM to $END_NUM

# Run the loop of runs for this task
for (( run=$START_NUM; run<=END_NUM; run++ )); do
  echo This is SLURM task $SLURM_ARRAY_TASK_ID, run number $run
  run_id=${MAP[$((run - 1))]}
  python {{ python_script_path }} {{ calcdir }}/$run_id
done

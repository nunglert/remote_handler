# --- NODE RESOURCE CHECK ---
rm -f node_check.info

HOST=$(hostname)
N_GPU_NODE=$(nvidia-smi -L | wc -l)
REQ_GPU={{ n_cores }}

if [[ "$N_GPU_NODE" -ne "$REQ_GPU" || "$HOST" == *.novalocal ]]; then
    echo "$HOST" > node_check.info
    exit 0
fi
# ---------------------------

nvidia-smi --query-gpu=index,timestamp,memory.used,memory.total,utilization.gpu --format=csv -l 1 > mem_log.csv &
SMI_PID=$!

python {{ python_script_path }} < {{ input_file }} > ns.out 

kill $SMI_PID
